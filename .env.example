# Copia este archivo como ".env" y completa tus claves. NUNCA subas el archivo ".env" a Git.

# ── Modelos de IA gratuitos (en orden de preferencia; si el primero falla se usa el siguiente) ──
LLM_PROVIDERS=openrouter,gemini

# OpenRouter: crea una clave gratuita en openrouter.ai (Settings, Keys)
OPENROUTER_API_KEY=
# "openrouter/free" elige solo un modelo gratuito vigente (los nombres :free cambian cada pocas semanas).
# Si prefieres uno fijo, elige uno que termine en ":free" (openrouter.ai/models, filtro "Free").
# Puedes usar el mismo nombre de modelo que tenías en n8n.
OPENROUTER_MODEL=openrouter/free

# Groq: crea una clave gratuita en la consola de Groq (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: crea una clave gratuita en Google AI Studio (aistudio.google.com)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama (modelo local, opcional, requiere: pip install langchain-ollama)
# Para usarlo agrégalo a LLM_PROVIDERS, por ejemplo: LLM_PROVIDERS=openrouter,gemini,ollama
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# Los nombres de modelo (sobre todo los :free de OpenRouter) cambian con el tiempo: si un proveedor responde "model not found",
# revisa en su documentación cuál es el nombre vigente y cámbialo aquí.

# ── Reintentos ante fallos del modelo ──
LLM_REINTENTOS=3
LLM_ESPERA_SEGUNDOS=2
LLM_TIMEOUT_SEGUNDOS=40

# ── Telegram (opcional: si se deja vacío, los avisos se omiten) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Base de datos ──
# En desarrollo se usa SQLite (se crea sola en la carpeta data/).
DATABASE_URL=sqlite:///./data/candidatos.db
# Al desplegar, usa PostgreSQL (Neon o Supabase), por ejemplo:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host/basededatos   (requiere: pip install "psycopg[binary]")

# ── Reglas de decisión (las mismas del Switch de n8n) ──
UMBRAL_ALTO=80
UMBRAL_MEDIO=60

# ── Límites ──
MAX_PDF_MB=10

# ── Módulo de visión (fotos de formularios) ──
# Tesseract es el lector de imágenes (OCR) y corre en tu propio computador o servidor.
# En Windows se busca solo en C:\Program Files\Tesseract-OCR\tesseract.exe; si lo instalaste en otra
# carpeta, escribe aquí la ruta completa del archivo tesseract.exe.
TESSERACT_CMD=
OCR_IDIOMAS=spa+eng
# Carpeta donde se guardan las fotos (fuera del panel público; solo se entregan por la API).
IMAGENES_DIR=data/imagenes
MAX_IMAGEN_MB=10
MAX_LADO_IMAGEN=2600
# Confianza (0 a 1) para pedir revisión humana. Se calibran con las pruebas de fotos reales.
UMBRAL_OCR=0.70
UMBRAL_CAMPO=0.60
# Por debajo de este valor la foto se rechaza sin llamar a la IA y se pide repetirla.
UMBRAL_OCR_MINIMO=0.45

# ── Tareas programadas (cron propio del motor) ──
# Cada TAREAS_MINUTOS el servidor reintenta las fotos que quedaron sin IA y, desde RESUMEN_HORA (hora de Colombia),
# envía una vez al día el resumen de candidatos por Telegram. También se ejecutan a mano en la pestaña Ejecuciones (admin).
TAREAS_ACTIVAS=true
TAREAS_MINUTOS=30
RESUMEN_HORA=8
ZONA_HORARIA_HORAS=-5

# ── Inicio de sesión y roles (semana 4) ──
# Secreto con el que se firman las sesiones. Pon una cadena larga y aleatoria, por ejemplo la salida de:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si lo dejas vacío se genera uno temporal y las sesiones se cierran cada vez que reinicias el servidor.
SESION_SECRETO=
SESION_HORAS=8
# true cuando el sitio corre con HTTPS (Render, Railway). En tu computador (http://127.0.0.1) déjalo en false.
COOKIE_SEGURA=false
# Usuarios de prueba que se crean solos la primera vez (admin, reclutador y consulta).
# Si el usuario ya existe, cambiar la clave aquí no lo modifica.
CLAVE_ADMIN=Admin.2026
CLAVE_RECLUTADOR=Recluta.2026
CLAVE_CONSULTA=Consulta.2026

# ── Memoria del chat (semana 4) ──
# Cuántos turnos (pregunta y respuesta) recuerda el asistente por usuario. 0 la desactiva.
CHAT_MEMORIA_TURNOS=6
